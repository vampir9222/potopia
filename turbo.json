{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "DATABASE_URL_UNPOOLED",
    "VERCEL_ENV",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "DISCORD_GUILD_ID",
    "ADMIN_DISCORD_IDS",
    "IGDB_CLIENT_ID",
    "GOTY_ENABLED",
    "IGDB_CLIENT_SECRET",
    "R2_ENDPOINT",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@app/web#build": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    }
  }
}
