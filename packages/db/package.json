{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "assemble": "tsx scripts/assemble.ts",
    "generate": "tsx scripts/assemble.ts && prisma generate",
    "db:migrate": "tsx scripts/assemble.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/assemble.ts && prisma migrate deploy",
    "db:reset:test": "tsx scripts/reset-test.ts",
    "deploy:production": "tsx scripts/deploy-production.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "tsx scripts/check-boundaries.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
