# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.
# Sur Vercel, déclarer les mêmes variables dans Project Settings > Environment Variables.

# ─── Base de données ──────────────────────────────────────────────────────
# En local : le Postgres du docker-compose (pnpm db:up), valeurs ci-dessous.
# En prod (Neon) :
#   DATABASE_URL = URL POOLÉE (hôte en "-pooler"), utilisée par l'application ;
#   DIRECT_URL   = URL DIRECTE (hôte sans "-pooler"), utilisée uniquement par les migrations.
#   Avec l'intégration Neon de Vercel, ces deux URL sont fournies sous les noms DATABASE_URL et
#   DATABASE_URL_UNPOOLED : la seconde remplace DIRECT_URL, rien à déclarer.
#   VERCEL_ENV (fournie par Vercel) vaut "production" en prod : c'est elle qui déclenche les
#   migrations après le build (packages/db/scripts/deploy-production.ts). Absente en local.
#   ex. postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/app?sslmode=require
DATABASE_URL="postgresql://app:app@localhost:5433/app"
DIRECT_URL="postgresql://app:app@localhost:5433/app"
# Base de test locale (docker compose, voir docker-compose.yml). Les tests la vident !
TEST_DATABASE_URL="postgresql://app:app@localhost:5433/app_test"

# ─── Auth (Better Auth) ───────────────────────────────────────────────────
# Secret aléatoire de 32+ caractères, à générer (différent en prod) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# URL publique de l'app (http://localhost:3000 en local, https://<projet>.vercel.app en prod)
BETTER_AUTH_URL="http://localhost:3000"

# ─── Discord OAuth ────────────────────────────────────────────────────────
# https://discord.com/developers/applications > ton app > OAuth2
# Redirect URI à déclarer : <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# ID du serveur Discord du groupe (mode développeur Discord > clic droit sur le serveur > Copier l'identifiant)
DISCORD_GUILD_ID=""
# IDs Discord des admins, séparés par des virgules
ADMIN_DISCORD_IDS=""

# ─── Cloudflare R2 (bucket PRIVÉ) ─────────────────────────────────────────
# Dashboard Cloudflare > R2 > Manage API tokens (droits Object Read & Write sur le bucket)
# En local : stockage compatible S3 du docker-compose (RustFS), avec les valeurs ci-dessous
# et R2_ENDPOINT renseigné ; R2_ACCOUNT_ID est alors ignoré. Créer le bucket : pnpm storage:init
# En prod : laisser R2_ENDPOINT vide (endpoint https://<account>.r2.cloudflarestorage.com).
R2_ENDPOINT="http://localhost:9000"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID="localaccess"
R2_SECRET_ACCESS_KEY="localsecret"
R2_BUCKET="app-local"
