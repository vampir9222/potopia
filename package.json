{
  "name": "platform",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db db:migrate",
    "db:deploy": "pnpm --filter @app/db db:deploy",
    "db:seed": "pnpm --filter @app/db db:seed",
    "db:reset:test": "pnpm --filter @app/db db:reset:test",
    "storage:init": "pnpm --filter @app/storage storage:init"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
